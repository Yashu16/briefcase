# neatlogs — Settings → API Keys at https://app.neatlogs.com
NEATLOGS_API_KEY=
# Optional EU ingest: https://eu.ingest.neatlogs.com
# NEATLOGS_ENDPOINT=

# LiteLLM (hackathon models). Claim at https://neatlogs.com/hackathon/models
LITELLM_API_KEY=
LITELLM_BASE_URL=https://litellm.neatlogs.com/v1
LITELLM_MODEL=claude-sonnet-4

# Crustdata company + people enrichment
CRUSTDATA_API_KEY=
CRUSTDATA_API_VERSION=2025-11-01

# Optional paid search. If empty, DuckDuckGo (ddgs) is used.
TAVILY_API_KEY=
